-- Amer Menu (executor build): Players-only Aimbot (sticky head lock) + ESP + Inf Jump
-- client only, re-execute safe

if not game:IsLoaded() then game.Loaded:Wait() end

local env = (getgenv and getgenv()) or _G
if env.AmerUnload then pcall(env.AmerUnload) end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
while not player do task.wait() player = Players.LocalPlayer end
local camera = Workspace.CurrentCamera

-- ===== settings =====
local JUMP_COOLDOWN = 0.1
local AIM_PART      = "Head"
local AIM_FOV       = 500     -- px radius, only for ACQUIRING a target
local PREDICTION    = 0       -- seconds of velocity lead; 0 = no shake. try 0.05 on fast targets
local MAX_DISTANCE  = 3000

local ENEMY_COLOR = Color3.fromRGB(255, 60, 60)
local TEAM_COLOR  = Color3.fromRGB(60, 255, 120)
local ON_COLOR    = Color3.fromRGB(46, 160, 67)
local OFF_COLOR   = Color3.fromRGB(170, 50, 50)

-- ===== state =====
local state = { infJump = false, aimbot = false, esp = false, wallAim = true, teamCheck = true }
local ready, running = false, true
local connections = {}
local function track(c) table.insert(connections, c) return c end

-- ===== gui parent (executor-safe) =====
local function guiParent()
	local ok, h = pcall(function() return gethui and gethui() end)
	if ok and h then return h end
	ok, h = pcall(function() return game:GetService("CoreGui") end)
	if ok and h then
		local t = pcall(function() return h.Name end)
		if t then return h end
	end
	return player:WaitForChild("PlayerGui")
end
local parent = guiParent()

local gui = Instance.new("ScreenGui")
gui.Name = "AmerGui"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 100
gui.Parent = parent

local espGui = Instance.new("ScreenGui")
espGui.Name = "AmerESP"
espGui.ResetOnSpawn = false
espGui.IgnoreGuiInset = true -- viewport coords == screen coords
espGui.DisplayOrder = 50
espGui.Parent = parent

