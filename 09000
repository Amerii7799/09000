-- ===== inf jump =====
local lastJump = 0
track(UserInputService.JumpRequest:Connect(function()
	if not ready or not state.infJump then return end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health > 0 and os.clock() - lastJump >= JUMP_COOLDOWN then
		lastJump = os.clock()
		hum:ChangeState(Enum.HumanoidStateType.Jumping)
	end
end))

-- ===== aimbot: sticky hard head lock =====
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
local locked = nil -- Player

-- sticky=true: skip the FOV check (already locked, stay on him)
local function validTarget(plr, myRoot, center, sticky)
	if not plr.Parent or isTeammate(plr) then return nil end
	local c, hum, root = charOf(plr)
	if not c then return nil end
	local part = c:FindFirstChild(AIM_PART) or root
	if (part.Position - myRoot.Position).Magnitude > MAX_DISTANCE then return nil end

	local sp = camera:WorldToViewportPoint(part.Position)
	if sp.Z <= 0 then return nil end
	local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
	if not sticky and d > AIM_FOV then return nil end

	if not state.wallAim then
		local origin = camera.CFrame.Position
		local hit = Workspace:Raycast(origin, part.Position - origin, rayParams)
		if hit and not hit.Instance:IsDescendantOf(c) then return nil end
	end
	return part, d
end

local function aimStep()
	if not ready or not state.aimbot then locked = nil return end
	camera = Workspace.CurrentCamera
	local myChar = player.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then return end

	rayParams.FilterDescendantsInstances = { myChar }
	local vp = camera.ViewportSize
	local center = Vector2.new(vp.X / 2, vp.Y / 2)

	local part
	if locked then
		part = validTarget(locked, myRoot, center, true)
		if not part then locked = nil end
	end

	if not part then
		local bestD = math.huge
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= player then
				local p, d = validTarget(plr, myRoot, center, false)
				if p and d < bestD then bestD, part, locked = d, p, plr end
			end
		end
	end

	if part then
		local aimPos = part.Position
		if PREDICTION > 0 then aimPos = aimPos + part.AssemblyLinearVelocity * PREDICTION end
		local camPos = camera.CFrame.Position
		if (aimPos - camPos).Magnitude > 0.5 then
			camera.CFrame = CFrame.new(camPos, aimPos)
		end
	end
end

-- after the default camera script so it never fights us
RunService:BindToRenderStep("AmerAim", Enum.RenderPriority.Camera.Value + 1, function()
	local ok, err = pcall(aimStep)
	if not ok then warn("[Amer aim]", err) end
end)
RunService:BindToRenderStep("AmerESP", Enum.RenderPriority.Camera.Value + 2, function()
	local ok, err = pcall(espStep)
	if not ok then warn("[Amer esp]", err) end
end)

-- ===== unload (re-execute safe) =====
env.AmerUnload = function()
	running, ready = false, false
	pcall(function() RunService:UnbindFromRenderStep("AmerAim") end)
	pcall(function() RunService:UnbindFromRenderStep("AmerESP") end)
	for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
	clearAllESP()
	pcall(function() gui:Destroy() end)
	pcall(function() espGui:Destroy() end)
	env.AmerUnload = nil
end

-- ===== intro =====
task.delay(3, function()
	if not running then return end
	splash:Destroy()
	menu.Visible = true
	ready = true
end)
