local function makeToggle(label, y, key, onChange)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -16, 0, 34)
	btn.Position = UDim2.new(0, 8, 0, y)
	btn.BackgroundColor3 = state[key] and ON_COLOR or OFF_COLOR
	btn.TextColor3 = Color3.new(1, 1, 1)
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 13
	btn.Text = label .. ": " .. (state[key] and "ON" or "OFF")
	btn.Parent = menu
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

	track(btn.Activated:Connect(function()
		state[key] = not state[key]
		btn.Text = label .. ": " .. (state[key] and "ON" or "OFF")
		btn.BackgroundColor3 = state[key] and ON_COLOR or OFF_COLOR
		if onChange then onChange(state[key]) end
	end))
end

-- ===== helpers (players only) =====
local function charOf(plr)
	local c = plr.Character
	if not c then return nil end
	local hum = c:FindFirstChildOfClass("Humanoid")
	local root = c:FindFirstChild("HumanoidRootPart")
	if not hum or not root or hum.Health <= 0 then return nil end
	return c, hum, root
end

local function isTeammate(plr)
	return state.teamCheck and plr.Team ~= nil and plr.Team == player.Team
end

-- ===== ESP: 2D box + name/hp/distance =====
local espObjs = {} -- [plr] = { frame, stroke, label }

local function clearESP(plr)
	local o = espObjs[plr]
	if o then o.frame:Destroy() espObjs[plr] = nil end
end

local function clearAllESP()
	for plr in pairs(espObjs) do clearESP(plr) end
end

local function makeESP(plr)
	local frame = Instance.new("Frame")
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.Visible = false
	frame.Parent = espGui

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = ENEMY_COLOR
	stroke.Parent = frame

	local label = Instance.new("TextLabel")
	label.AnchorPoint = Vector2.new(0.5, 1)
	label.Position = UDim2.new(0.5, 0, 0, -2)
	label.Size = UDim2.fromOffset(180, 32)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextSize = 12
	label.TextColor3 = ENEMY_COLOR
	label.TextStrokeTransparency = 0.4
	label.Parent = frame

	espObjs[plr] = { frame = frame, stroke = stroke, label = label }
	return espObjs[plr]
end

local function espStep()
	if not ready or not state.esp then return end
	camera = Workspace.CurrentCamera
	local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not myRoot then return end

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			local c, hum, root = charOf(plr)
			local o = espObjs[plr]
			if not c then
				if o then o.frame.Visible = false end
			else
				o = o or makeESP(plr)
				local dist = (root.Position - myRoot.Position).Magnitude
				local top = camera:WorldToViewportPoint(root.Position + Vector3.new(0, 3.2, 0))
				local bot = camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3.4, 0))
				if dist > MAX_DISTANCE or top.Z <= 0 or bot.Z <= 0 then
					o.frame.Visible = false
				else
					local h = math.max(math.abs(bot.Y - top.Y), 8)
					local w = h * 0.55
					o.frame.Size = UDim2.fromOffset(w, h)
					o.frame.Position = UDim2.fromOffset(top.X - w / 2, top.Y)
					local col = isTeammate(plr) and TEAM_COLOR or ENEMY_COLOR
					o.stroke.Color = col
					o.label.TextColor3 = col
					o.label.Text = string.format("%s\n%d HP | %dm", plr.Name, math.floor(hum.Health), math.floor(dist))
					o.frame.Visible = true
				end
			end
		end
	end
end

track(Players.PlayerRemoving:Connect(clearESP))

-- ===== toggles =====
makeToggle("Aimbot", 30, "aimbot", function(on) fovCircle.Visible = on end)
makeToggle("ESP", 68, "esp", function(on) if not on then clearAllESP() end end)
makeToggle("Wall Aim", 106, "wallAim")
makeToggle("Team Check", 144, "teamCheck")
