menu.Position = UDim2.new(0, 12, 0.5, -113)
menu.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
menu.BackgroundTransparency = 0.15
menu.BorderSizePixel = 0
menu.Visible = false
